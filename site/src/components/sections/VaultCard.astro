---
import { classLabel, classSlug, personaLabel, tierOf, tierLabel, tierSlug } from '../../utils/vaultLabels';

interface Props { vault: any; }
const { vault } = Astro.props;

// HAUSSMANN P2.4 (ADR-052 §tiers, accepted): the meta pill is the LIFECYCLE TIER, not the raw
// status. `statusLabel()` shipped `pending` and `genesis` straight to a stranger — "pending
// what?", and "genesis" is house jargon. `in use` / `chartered` / `planned` say the same thing in
// words a newcomer already owns, and the tier is derived from `status` alone so the badge cannot
// drift from the data (§tiers.3).
const tier = tierOf(vault.status);
// The class moved onto the card because the page no longer groups by it. Under the tier-first
// layout (variant A, ⛩ 2026-08-19) the class heading is gone, so a card that didn't carry its own
// class label would silently lose that fact for every vault on the page.
const classPub = classLabel(vault.class);
// §tiers.1: `card_present` is a DOCUMENTATION signal, disqualified as a lifecycle input. It ships
// as card completeness, never as a rank, and it says what it means in both directions — 50 of 74
// rows have no card, and a blank there would read as an oversight rather than a fact.
const documented = vault.card_present === true;

// Refit M2 / DP1 (2026-07-21, ratification_record_refit_g1): `tagline` is the canonical
// per-vault purpose field (`headline_mission` retired — 0/73 populated, never authored);
// fall back to `note` (the populated one-liner) so the purpose renders NOW from existing
// data and auto-upgrades as Home backfills taglines. No strings authored here.
const purpose = vault.tagline || vault.note || null;
// P1.3: persona placeholders project as null upstream; personaLabel keeps the display rule
// local too (belt + braces). Class/status render as public labels; attributes carry the
// hyphenated slug so raw machine enums never reach built HTML (gate-27 scans attributes).
const persona = personaLabel(vault.persona);
// Flat search haystack for the client-side registry filter (M3.1.3); no-JS ignores it.
// The tier label joins it so a reader who types "chartered" finds the ten chartered vaults.
const searchBlob = [vault.display_name, persona, classPub, tierLabel(tier), purpose]
  .filter(Boolean).join(' ').toLowerCase();
---

<article
  class={`vault-card class-${classSlug(vault.class)}`}
  data-vault-card
  data-class={classSlug(vault.class)}
  data-tier={tierSlug(tier)}
  data-search={searchBlob}
>
  <h3>
    <a href={`/vaults/${vault.vault_slug}/`}>{vault.display_name}</a>
  </h3>
  <p class="vault-card-meta">
    <span class={`vault-tier tier-${tierSlug(tier)}`}>{tierLabel(tier)}</span>
    <span class="vault-card-class">{classPub}</span>
    {vault.current_phase && <span class="vault-phase">{vault.current_phase}</span>}
  </p>
  {persona
    ? <p class="vault-card-persona">{persona}</p>
    : <p class="vault-card-persona vault-card-absent">No persona recorded</p>}
  {purpose
    ? <p class="vault-card-purpose">{purpose}</p>
    : <p class="vault-card-purpose vault-card-absent">{vault.listing === 'minimal' ? 'Minimal card — private engagement.' : 'No public description yet.'}</p>}
  <p class="vault-card-documented">
    {documented ? 'Documented' : <span class="vault-card-absent">No card written yet</span>}
  </p>
</article>

<style>
  /* Token-driven (audit P1 / campaign_adna_network_audit DS5): replaces hardcoded light-mode greys +
     off-palette blue hover + pale-pastel status fills that inherited dark page text at 1.15:1 (78-node
     WCAG-AA failure on the Tokyo-Night register). Status pills mirror RegistryCard's AA-safe color-mix
     (text darkened toward --color-text so the label meets AA on its own pale tint, both modes). */
  /* Storyweave P5 M5.2 / B11: harmonized with RegistryCard — tokenized padding
     (1rem = --space-4) + the --color-primary hover the sibling card tiers share
     (was the off-tier --color-link blue). Density stays denser than RegistryCard
     by design (this is the /vaults listing card). */
  .vault-card { padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-lg); transition: border-color var(--transition-fast); }
  .vault-card:hover { border-color: var(--color-primary); }
  .vault-card h3 a { text-decoration: none; color: var(--color-text-heading); }
  .vault-card-persona { color: var(--color-text-muted); font-size: 0.9em; margin: 0.25rem 0; }
  .vault-card-tagline { font-style: italic; color: var(--color-text-muted); margin: 0.5rem 0; }
  /* Storyweave P3 / M3.1: the purpose line — one line, tail-truncated with a real ellipsis.
     The full text stays in the DOM (screen readers read it in full); only the visual is clipped
     at the card edge, so no word is ever hard-cut in the content. Token colour (gate-14). */
  .vault-card-purpose {
    color: var(--color-text);
    font-size: 0.9em;
    margin: 0.4rem 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* P1.3 honest-absent affordance (WebForge data-honesty law): a vault with no public
     description — or no persona, or no card — says so plainly. Never a blank, never invented
     copy, never a placeholder dash (P1.3's "— —" titles are the cautionary instance). */
  .vault-card-absent { color: var(--color-text-muted); font-style: italic; }
  .vault-card-meta { font-size: 0.8em; margin-top: 0.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .vault-card-class { color: var(--color-text-muted); }
  .vault-card-documented { font-size: 0.8em; margin: 0.4rem 0 0; color: var(--color-text-muted); }

  /* HAUSSMANN P2.4 — the lifecycle-tier badge (ADR-052 §tiers).
     Deliberately NOT a heat scale. `in use` gets the success tint the old `active` pill had, but
     `chartered` and `planned` share one neutral accent tint rather than descending through a
     warning colour: a gradient would encode a quality judgment onto a self-declared field, which
     is the one thing §tiers.2 says this surface must not do. AA-safe color-mix, both modes. */
  .vault-tier { padding: 0.1rem 0.4rem; border-radius: var(--radius-full); }
  .tier-in-use { background: color-mix(in srgb, var(--color-success) 15%, transparent); color: color-mix(in srgb, var(--color-success) 55%, var(--color-text)); }
  .tier-chartered,
  .tier-planned { background: color-mix(in srgb, var(--color-accent) 18%, transparent); color: color-mix(in srgb, var(--color-accent) 45%, var(--color-text)); }
</style>
