---
/**
 * One page per numbered spec section (HAUSSMANN P2.3 O1).
 *
 * Entries are generated by scripts/split_specification.mjs from the single projected
 * specification.mdx, so this renders through exactly the same markdown pipeline as every other
 * doc — no second renderer, and therefore no way for section pages to drift in styling or
 * syntax highlighting from the full document.
 *
 * `prev`/`next` are the DocumentationLayout props that already existed; PrevNextNav renders them.
 */
import { getCollection, render } from 'astro:content';
import DocumentationLayout from '../../../layouts/DocumentationLayout.astro';
import { sourceForSpec } from '../../../utils/contentSource';
import { buildTechArticleJsonLD, buildBreadcrumbListJsonLD } from '../../../utils/seo';
import { SITE_ORIGIN } from '../../../data/canonical';

export async function getStaticPaths() {
  const sections = await getCollection('spec');
  const bySlugId = new Map(sections.map((s) => [s.data.slug_id, s]));
  return sections.map((section) => ({
    params: { slug: section.data.slug_id },
    props: {
      section,
      prevSection: section.data.prev ? bySlugId.get(section.data.prev) : undefined,
      nextSection: section.data.next ? bySlugId.get(section.data.next) : undefined,
    },
  }));
}

const { section, prevSection, nextSection } = Astro.props;
const { Content, headings } = await render(section);

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? SITE_ORIGIN;
const heading = `${section.data.number}. ${section.data.section_title}`;

const jsonLD = [
  buildTechArticleJsonLD({
    title: heading,
    description: section.data.description ?? '',
    url: Astro.url.href,
  }),
  buildBreadcrumbListJsonLD([
    { name: 'Home', url: `${siteBase}/` },
    { name: 'Reference', url: `${siteBase}/reference/` },
    { name: 'aDNA Specification', url: `${siteBase}/reference/specification/` },
    { name: heading },
  ]),
];

const prev = prevSection
  ? { label: `${prevSection.data.number}. ${prevSection.data.section_title}`, href: `/reference/specification/${prevSection.data.slug_id}/` }
  : { label: 'Specification contents', href: '/reference/specification/' };
const next = nextSection
  ? { label: `${nextSection.data.number}. ${nextSection.data.section_title}`, href: `/reference/specification/${nextSection.data.slug_id}/` }
  : { label: 'Read the full specification', href: '/reference/specification/full/' };
---

<DocumentationLayout
  title={heading}
  description={section.data.description ?? `aDNA Specification §${section.data.number}.`}
  headings={headings}
  prev={prev}
  next={next}
  jsonLD={jsonLD}

  source={sourceForSpec()}
>
  <p class="spec-section-meta">
    <a href="/reference/specification/">aDNA Specification</a>
    <span aria-hidden="true">·</span>
    <span>v{section.data.version}</span>
    <span aria-hidden="true">·</span>
    <span>Section {section.data.number} of 20</span>
    <span aria-hidden="true">·</span>
    <a href="/reference/specification/full/">Full text</a>
  </p>
  <Content />
</DocumentationLayout>

<style>
  .spec-section-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .spec-section-meta a { color: var(--color-link); font-weight: 500; }
</style>
