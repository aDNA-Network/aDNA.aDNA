// `.adna/`; the workspace router CLAUDE.md sits at the repo root. Every path below was
// live-verified 200 (unauthenticated) against the public image.
const proofLinks = [
  { path: 'CLAUDE.md', href: `${REPO_HTTPS}/blob/main/CLAUDE.md`, note: 'the workspace operating protocol an agent loads first' },
  { path: '.adna/', href: `${REPO_HTTPS}/tree/main/.adna`, note: 'the full aDNA standard, embedded and ready to clone' },
  { path: '.adna/how/skills/skill_onboarding.md', href: `${REPO_HTTPS}/blob/main/.adna/how/skills/skill_onboarding.md`, note: 'the first-run recipe that orients a new project' },
  { path: '.adna/how/skills/skill_project_fork.md', href: `${REPO_HTTPS}/blob/main/.adna/how/skills/skill_project_fork.md`, note: 'how a new .aDNA project is created' },
  { path: '.adna/how/templates/template_workspace_claude.md', href: `${REPO_HTTPS}/blob/main/.adna/how/templates/template_workspace_claude.md`, note: 'the router template every workspace starts from' },
