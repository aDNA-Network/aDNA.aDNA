---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import NetworkDiagram from '../components/sections/NetworkDiagram.astro';
import RegistryCard from '../components/sections/RegistryCard.astro';
import { buildWebSiteJsonLD } from '../utils/seo';
import { audiences, governanceExample, projectTree } from '../data/home';
import { STANDARD_VERSION, ENTITY_TYPE_COUNT, STANDARD_LICENSE } from '../data/standard';
import vaultsData, { canonicalVaultSlug } from '../data/vaults';
import { classLabel as sharedClassLabel } from '../utils/vaultLabels';
import subnetworksData from '../data/subnetworks.json';
// HAUSSMANN P1.2 — the derived network facts the hero, /about and /state-of-the-network all state.
// One module so the three surfaces cannot disagree; never type a count here (KW-14).
import { connectedCount, edgeCount } from '../data/network_state';
// Storyweave P5 / M5.1a — the single-sourced clone-and-run one-liner for the hero install pill (R2).
// Same fixture /get-started + /network consume (built by scripts/build_install_truth.mjs); never
// hardcoded. HOME-ONLY additive-optional prop → /network + /commons stay zero-diff.
import installTruth from '../data/install_truth.json';
import heroImage from '../assets/heroes/hero_adna_helix.png';
// Storyweave direction A — the "living network" hero graph: the compact connected-component radial
// pre-rendered by scripts/build_graph_svg.mjs (npm run sync:graph) → committed static SVG, imported
// raw and inlined by HomeHero as the graph-led hero. HOME-ONLY (the additive-optional `heroGraph`
// prop; /network + /commons don't pass it → they keep the image-led hero, zero-diff).
import heroGraph from '../assets/hero_graph.svg?raw';
// HAUSSMANN P3.3 O3 — the machine-door block's twin count, DERIVED from the same manifest that
// drives twin emission and negotiation (scripts/emit_bespoke_twins.mjs + inject_negotiation.mjs).
// Never typed: KW-14 / convention 1. If a twin stops being emitted this number falls with it.
import twinManifest from '../data/twin_manifest.json';
// HAUSSMANN GR-4 O4 · D5 — the returning-member entry point (Grande Revue P2-7). The same sorted
// collection /changelog renders, so the strip cannot show a different "latest" than the page it
// links to. DERIVED, never typed (KW-14 / convention 1): if an entry lands, this moves with it.
import { getSortedChangelog } from '../utils/collections';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://adna.network';
const twinCount = (twinManifest as { twins: string[] }).twins.length;
const jsonLD = buildWebSiteJsonLD(siteUrl);

// Section 2 — a curated slice across the network's classes (real data/vaults.json
// records), including two public-good org vaults (WGA, Rare Archive) to thread the
// ethos by what is shown. "See all" routes to the full /vaults registry.
const REGISTRY_SLUGS = [
  'aDNA.aDNA', 'III.aDNA', 'canvas', 'Operations.aDNA',
  'LAVentureGraph.aDNA', 'Home.aDNA', 'wga.aDNA', 'RareArchive.aDNA',
];
const bySlug: Record<string, any> = Object.fromEntries(
  (vaultsData.vaults as any[]).map((v) => [v.vault_slug, v])
);
// Curated names are resolved through canonicalVaultSlug (HAUSSMANN P2.1 / ADR-051) so this
// slice survives a slug change. It also FAILS THE BUILD on a miss rather than filtering it
// away: the previous `.filter(Boolean)` meant a name that stopped resolving silently shrank
// the homepage's registry preview, which is precisely how P2.1's canonicalization would have
// dropped six of these eight cards with no error anywhere.
const registryVaults = REGISTRY_SLUGS.map((s) => {
  const v = bySlug[canonicalVaultSlug(s)];
  if (!v) throw new Error(`index.astro REGISTRY_SLUGS: "${s}" resolves to no vault in the registry`);
  return v;
});
const vaultCount = vaultsData.vault_count;

// Section 5 — the featured public-good subnetworks, teased data-driven from the
// subnetworks.json fixture (names/taglines single-sourced, never hardcoded — the
// E1-deferred §5 tease now hands off to the live /commons surface; E5 c165).
const subnetworks = subnetworksData.subnetworks as Array<{
  id: string;
  display_name: string;
  tagline: string;
}>;

const CLASS_LABELS: Record<string, string> = {
  standard_dev: 'the standard',
  framework: 'framework',
  framework_candidate: 'framework',
  forge: 'forge',
  platform: 'platform',
  org_vault: 'org vault',
  org_graph: 'org graph',
  network: 'network',
  node_operational: 'node',
  coordination: 'coordination',
  document: 'document',
  knowledge_graph: 'knowledge graph',
  tooling: 'tooling',
  workspace: 'workspace',
};
// Curated homepage register above; anything uncurated falls to the shared public label
// (never a raw enum — gate-27; HAUSSMANN P1.3).
const classLabel = (c: string) => CLASS_LABELS[c] ?? sharedClassLabel(c);

/* ── Section 6 (HAUSSMANN GR-4 O4 · D5 · AC-5) — "What's new" ───────────────────────────────────
 *
 * The Grande Revue's P2-7: changelog + RSS were reachable ONLY from the footer, so a returning
 * member had no what's-new entry point at all. ADR-049 caps the top nav at 7 flat entries, so the
 * ratified remedy is a homepage strip and explicitly NOT an eighth nav item.
 *
 * ⛩ FORM RULED AT O4's OPEN (SO#1): a dated strip with NO lead sentence. That is a reading-level
 * decision as much as an editorial one. `/` clears its FKGL target by 0.04 — the tightest margin on
 * the site — and `reading_census.mjs`'s `unpunctuated-block` predicate drops a block carrying zero
 * sentence terminators. A dated link list has none, so this section contributes NOTHING to the
 * prose corpus BY CONSTRUCTION rather than by luck.
 *
 * ⭐ That was MEASURED before this was written, not reasoned about: the `subnetwork-tease` list
 * forty lines below is the identical shape (`- [link](/href) unpunctuated label`) and the census
 * already classifies it `unpunctuated-block` on this very page. `G54s` asserts the property so it
 * RECURS — convention 16's law, that a verification with no recurrence is a claim about the past
 * wearing the grammar of the present. ⚠ The fragility it guards is real and specific: give any
 * entry a title ending in a full stop and `stops` becomes 1, the block survives the predicate, and
 * this section silently enters the corpus against a 0.04 margin.
 */
const LATEST_COUNT = 3;
const latestEntries = (await getSortedChangelog()).slice(0, LATEST_COUNT);

/* Titles are authored as `<version> — <headline>`, which would print the date twice beside the
 * `date` field. Stripped only when the prefix is LITERALLY there, so a title that does not follow
 * the convention degrades to itself rather than being surgically mangled. */
const changelogHeadline = (title: string, version: string) =>
  title.startsWith(`${version} — `) ? title.slice(version.length + 3) : title;

/* `timeZone: 'UTC'` is load-bearing, not cosmetic — R-126. A frontmatter `date: 2026-08-28` parses
 * to UTC midnight; formatted without a zone it renders in the BUILD MACHINE's, so a build from PDT
 * printed "August 27". Same fix, same reason, as changelog.astro's own date line. */
const changelogDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="aDNA — project knowledge, organized for AI"
  description="aDNA (Agentic DNA) is an open standard for organizing a project's files. Inspect the structure, start a local workspace, and choose what to share."
  jsonLD={jsonLD}
>
  <HomeHero
    heroImage={heroImage}
    heroAlt="A pixel-art DNA helix rising from small computers into connected nodes, in the Tokyo Night palette."
    title="Project knowledge, organized for AI."
    lead="aDNA (Agentic DNA) is an open standard for organizing a project's files. Three folders and plain Markdown give people and AI agents a shared map."
    audienceSub="Start a local workspace with Git and Claude Code."
    notLine="Not a product or service — no server, no signup; aDNA itself sends nothing."
    reframe="The standard that gives it that shape is open. Your files stay on your machine. Your AI tool has its own data handling."
    primaryHref="/get-started"
    primaryLabel="Get Started"
    secondaryHref="/reference/specification"
    secondaryLabel="Read the standard"
    installOneLiner={installTruth.one_liner}
    showLicenseEyebrow={true}
  >
    <div slot="example" class="file-example">
      <h2>A project you can inspect</h2>
      <pre class="project-tree" tabindex="0" aria-label="aDNA project file structure"><code>{projectTree}</code></pre>
      <p>The site you are reading uses this structure. Its instruction file tells an agent how to work:</p>
      <pre class="governance-example" tabindex="0" aria-label="Excerpt from this project's actual agent instructions"><code>{governanceExample}</code></pre>
      <a href="https://github.com/aDNA-Network/aDNA.aDNA/blob/main/CLAUDE.md" class="example-source">Read the full instruction file</a>
      <p class="example-limit">These are written instructions. The structure does not enforce an agent’s behavior.</p>
    </div>
  </HomeHero>

  <section class="movement-band" aria-labelledby="inheritance-title">
    <div class="section-inner">
      <h2 id="inheritance-title" class="section-title">Knowledge worth passing on</h2>
      <p class="movement-lyric">Think of it as AI DNA: the instructions, decisions and knowledge an agent can read.</p>
      <p class="movement-reframe">DNA carries our biological inheritance. The knowledge we choose to share can become a cultural inheritance for AI. We want people to build, question and improve it together, for the good of all.</p>
      <p class="movement-reframe">Share what you choose. Keep the rest private. Democratic stewardship is the goal; <a href="/about/">Stanley Bishop stewards the project today</a>.</p>
    </div>
  </section>

  <section class="living-registry" aria-labelledby="current-work-title">
    <div class="section-inner">
      <h2 id="current-work-title" class="section-title">What exists today</h2>
      <p class="section-subtitle">A <a href="/learn/what-is-adna/">vault</a> is a project folder that follows the standard. Here is a selection from the registry.</p>
      <p class="registry-disclosure">{vaultCount} vaults — every one of them on a single computer, ours. {connectedCount} are joined by {edgeCount} declared relationships; the rest stand alone. <a href="/state-of-the-network/">The state of the network, dated</a>.</p>
      <p class="registry-disclosure">“Tended by” names an <a href="/about/#agent-stewards">AI persona</a>, not a person. <a href="/about/">Who’s behind aDNA</a>.</p>
      <div class="registry-grid">
        {registryVaults.map((v) => <RegistryCard vault={v} classLabel={classLabel(v.class)} />)}
      </div>
      <details class="network-detail">
        <summary>Inspect the declared relationships</summary>
        <div class="registry-graph dark" set:html={heroGraph} />
        <p>{connectedCount} connected vaults · {edgeCount} relationships. <a href="/vaults/graph/">Open the graph and its keyboard navigation</a>.</p>
        <NetworkDiagram />
      </details>
      <p class="registry-actions"><a href="/vaults/">See all {vaultCount} vaults</a></p>
    </div>
  </section>

  <section class="the-standard" aria-labelledby="standard-title">
    <div class="section-inner">
      <h2 id="standard-title" class="section-title">Inspect the standard</h2>
      <p class="section-subtitle">The specification describes the file structure and its rules. Your notes are plain Markdown. Read them in Obsidian, VS Code or GitHub. The workspace gives you a starting point.</p>
      <div class="standard-meta">
        <span class="meta-tag">{STANDARD_VERSION}</span>
        <span class="meta-tag">{STANDARD_LICENSE} License</span>
        <a class="meta-tag" href="/learn/what-is-adna#entity-types">{ENTITY_TYPE_COUNT} Entity Types</a>
      </div>
      <div class="standard-cta">
        <a href="/reference/specification" class="btn btn-primary">Read the Specification</a>
        <a href="https://github.com/aDNA-Network/aDNA" class="btn btn-secondary">View on GitHub</a>
      </div>
      <div class="learn-onramp">
        <h3 class="onramp-title">New to aDNA? Start here</h3>
        <p class="onramp-lead">Explore the <a href="/learn/what-is-adna">short introduction</a>, <a href="/learn">concepts</a> or <a href="/learn/tutorials">tutorials</a>.</p>
      </div>
      <div class="machine-door">
        <h3>Built to be read by agents</h3>
        <p>This site provides text and data alongside its pages:</p>
        <ul class="door-list">
          <li class="door-item"><a href="/llms.txt" class="door-path">/llms.txt</a><span class="door-note">A curated index. <a href="/llms-full.txt">/llms-full.txt</a> contains the full corpus.</span></li>
          <li class="door-item"><span class="door-path">Markdown twins</span><span class="door-note">{twinCount} pages have a text version. Add <code>.md</code> to a documentation URL, or request <code>Accept: text/markdown</code>.</span></li>
          <li class="door-item"><a href="/api/registry.v1.json" class="door-path">/api/registry.v1.json</a><span class="door-note">The registry as versioned JSON.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="join-network" aria-labelledby="participate-title">
    <div class="section-inner">
      <h2 id="participate-title" class="section-title">Build with us</h2>
      <p class="section-subtitle">Try the workspace. Report a confusing instruction. Propose a change to the <a href="/reference/governance-model/">standard</a>. Each is a way to help.</p>
      <div class="join-cta">
        <a href="/community/" class="btn btn-primary">Find a way to contribute</a>
        <a href="/commons/" class="btn btn-secondary">See the public-good work</a>
      </div>
      <p class="audience-pathways"><span class="pathways-label">aDNA for</span>{audiences.map((a, i) => <Fragment><a href={a.href}>{a.label}</a>{i < audiences.length - 1 && <span class="sep" aria-hidden="true">·</span>}</Fragment>)}</p>
    </div>
    <div class="latest-strip">
    <div class="section-inner">
      <h2 class="section-title">What's new</h2>
      <ul class="latest-list" role="list">
        {latestEntries.map((e) => (
          <li class="latest-item">
            <a href="/changelog" class="latest-date">
              <time datetime={e.data.date.toISOString()}>{changelogDate(e.data.date)}</time>
            </a>
            <span class="latest-headline">{changelogHeadline(e.data.title, e.data.version)}</span>
          </li>
        ))}
      </ul>
      <p class="latest-actions">
        <a href="/changelog" data-astro-prefetch>Full changelog</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/rss.xml">RSS feed</a>
      </p>
    </div>
  </div>
  </section>
</BaseLayout>

<style>
  /* agent_codex · 2026-09-15: existing tokens, text-first homepage evidence slot. */
  .file-example { color: var(--color-text); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); padding: var(--space-6); text-align: left; }
  .file-example h2 { font-size: var(--text-lg); margin: 0 0 var(--space-5); color: var(--color-text-heading); }
  .file-example p { font-size: var(--text-sm); margin: var(--space-5) 0; line-height: 1.6; }
  .file-example pre { max-width: 100%; overflow-x: auto; font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.65; margin: 0; padding: var(--space-4); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .file-example .governance-example { white-space: pre-wrap; overflow-wrap: anywhere; }
  .file-example .example-limit { margin-bottom: 0; }
  .example-source { display: inline-block; margin-top: var(--space-4); font-size: var(--text-sm); }
  .network-detail { max-width: var(--prose-width); margin: var(--space-8) auto; }
  .network-detail summary { cursor: pointer; padding: var(--space-4) 0; color: var(--color-link); }
  .registry-graph { max-width: 36rem; margin: var(--space-6) auto; background: var(--color-bg); border-radius: var(--radius-lg); }
  .registry-graph :global(svg) { display: block; width: 100%; height: auto; }
  .latest-strip { margin-top: var(--space-12); }
  .machine-door h3 { font-size: var(--text-2xl); }
  @media(max-width: 600px) { .file-example { padding: var(--space-4); } .file-example pre { font-size: var(--text-sm); padding: var(--space-3); } }

  /* ——— Movement band (ADR-048): the demoted manifesto lyric, one quiet full-width statement
     directly below the fold. Reads as the "why", after the hero has answered the "what". ——— */
  .movement-band {
    padding: var(--space-10) var(--space-6);
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .movement-lyric {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-text);
    text-wrap: balance;
  }

  /* The concrete twin under the lyric — quieter and smaller, so the lyric keeps the band and this
     grounds it rather than competing with it. */
  .movement-reframe {
    max-width: 42rem;
    margin: var(--space-5) auto 0;
    text-align: center;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* ——— Shared section styles ——— */
  .section-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .section-title {
    font-size: var(--text-3xl);
    text-align: center;
    margin-bottom: var(--space-3);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    max-width: 36rem;
    margin: 0 auto var(--space-10);
    line-height: 1.6;
  }

  /* The disclosure line under the registry count — sits between the subtitle and the grid, quieter
     than the subtitle it qualifies. It pulls up under the subtitle's bottom margin so the pair
     reads as one block. */
  .registry-disclosure {
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    max-width: 36rem;
    margin: calc(var(--space-10) * -1 + var(--space-3)) auto var(--space-10);
    line-height: 1.6;
  }

  /* ——— 1 · What a context democracy is ——— */
  .context-democracy {
    padding: var(--space-24) 0;
  }

  /* Storyweave P3 / M3.2 — the S7 first-scroll 4-pillar payoff. Tokens only (AA both modes). */
  .democracy-pillars {
    list-style: none;
    padding: 0;
    margin: var(--space-8) auto 0;
    max-width: 60rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }
  .democracy-pillars li {
    text-align: left;
    padding: var(--space-4);
    border-top: 2px solid var(--color-primary);
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
  }
  .democracy-pillars strong {
    display: block;
    font-family: var(--font-display);
    color: var(--color-text-heading);
    margin-bottom: var(--space-1);
  }
  .democracy-pillars span {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  @media (max-width: 780px) {
    .democracy-pillars { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 420px) {
    .democracy-pillars { grid-template-columns: 1fr; }
  }

  .diagram-caption {
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    max-width: 34rem;
    margin: var(--space-8) auto 0;
    line-height: 1.6;
  }

  /* ——— 2 · The living registry ——— */
  .living-registry {
    padding: var(--space-24) 0;
  }

  .registry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-5);
  }

  .registry-actions {
    text-align: center;
    margin-top: var(--space-10);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-sm);
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .registry-actions a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .registry-actions a:hover {
    text-decoration: underline;
  }

  .registry-actions .sep {
    color: var(--color-border);
  }

  /* ——— How it Works ——— */
  .how-it-works {
    padding: var(--space-24) 0;
    background: var(--color-bg-alt);
    overflow-x: hidden;
  }

  .feature-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-12);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-primary);
  }

  .feature-item strong {
    font-size: var(--text-base);
    color: var(--color-text-heading);
  }

  .feature-item span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-8);
  }

  .step {
    text-align: center;
    padding: var(--space-8) var(--space-6);
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    min-width: 0;
  }

  .step-number {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    /* Cyan accent — AA both modes (purple --color-primary fails for sm text). */
    color: var(--color-link);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .step-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .step-description {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .step-demo {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #13131f;
    width: 100%;
    box-sizing: border-box;
  }

  .step-demo-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: #1c1c2e;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .demo-dots {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .demo-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .demo-dots span:nth-child(1) { background: #ff5f57; }
  .demo-dots span:nth-child(2) { background: #febc2e; }
  .demo-dots span:nth-child(3) { background: #28c840; }

  .demo-filename {
    color: #aaa;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.01em;
  }

  .step-demo-pre {
    margin: 0;
    padding: var(--space-4);
    color: #c9c9df;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.65;
    white-space: pre;
    overflow-x: auto;
    max-width: 100%;
    box-sizing: border-box;
  }

  .how-footer {
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-10);
    line-height: 1.6;
  }

  .how-footer a {
