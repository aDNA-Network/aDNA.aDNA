---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import NetworkDiagram from '../components/sections/NetworkDiagram.astro';
import RegistryCard from '../components/sections/RegistryCard.astro';
import { buildWebSiteJsonLD } from '../utils/seo';
import { steps, stats, audiences } from '../data/home';
import { STANDARD_VERSION, ENTITY_TYPE_COUNT } from '../data/standard';
import vaultsData from '../data/vaults.json';
import { classLabel as sharedClassLabel } from '../utils/vaultLabels';
import subnetworksData from '../data/subnetworks.json';
// HAUSSMANN P1.2 — the derived network facts the hero, /about and /state-of-the-network all state.
// One module so the three surfaces cannot disagree; never type a count here (KW-14).
import { connectedCount, edgeCount } from '../data/network_state';
// Storyweave P5 / M5.1a — the single-sourced clone-and-run one-liner for the hero install pill (R2).
// Same fixture /get-started + /network consume (built by scripts/build_install_truth.mjs); never
// hardcoded. HOME-ONLY additive-optional prop → /network + /commons stay zero-diff.
import installTruth from '../data/install_truth.json';
import heroImage from '../assets/heroes/hero_adna_helix.png';
// Storyweave direction A — the "living network" hero graph: the compact connected-component radial
// pre-rendered by scripts/build_graph_svg.mjs (npm run sync:graph) → committed static SVG, imported
// raw and inlined by HomeHero as the graph-led hero. HOME-ONLY (the additive-optional `heroGraph`
// prop; /network + /commons don't pass it → they keep the image-led hero, zero-diff).
import heroGraph from '../assets/hero_graph.svg?raw';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://adna.network';
const jsonLD = buildWebSiteJsonLD(siteUrl);

// Section 2 — a curated slice across the network's classes (real data/vaults.json
// records), including two public-good org vaults (WGA, Rare Archive) to thread the
// ethos by what is shown. "See all" routes to the full /vaults registry.
const REGISTRY_SLUGS = [
  'aDNA.aDNA', 'III.aDNA', 'canvas', 'Operations.aDNA',
  'LAVentureGraph.aDNA', 'Home.aDNA', 'wga.aDNA', 'RareArchive.aDNA',
];
const bySlug: Record<string, any> = Object.fromEntries(
  (vaultsData.vaults as any[]).map((v) => [v.vault_slug, v])
);
const registryVaults = REGISTRY_SLUGS.map((s) => bySlug[s]).filter(Boolean);
const vaultCount = vaultsData.vault_count;

// Section 5 — the featured public-good subnetworks, teased data-driven from the
// subnetworks.json fixture (names/taglines single-sourced, never hardcoded — the
// E1-deferred §5 tease now hands off to the live /commons surface; E5 c165).
const subnetworks = subnetworksData.subnetworks as Array<{
  id: string;
  display_name: string;
  tagline: string;
}>;

const CLASS_LABELS: Record<string, string> = {
  standard_dev: 'the standard',
  framework: 'framework',
  framework_candidate: 'framework',
  forge: 'forge',
  platform: 'platform',
  org_vault: 'org vault',
  org_graph: 'org graph',
  network: 'network',
  node_operational: 'node',
  coordination: 'coordination',
  document: 'document',
  knowledge_graph: 'knowledge graph',
  tooling: 'tooling',
  workspace: 'workspace',
};
// Curated homepage register above; anything uncurated falls to the shared public label
// (never a raw enum — gate-27; HAUSSMANN P1.3).
const classLabel = (c: string) => CLASS_LABELS[c] ?? sharedClassLabel(c);
---

<BaseLayout
  title="aDNA — the open standard & network for shared context"
  description="aDNA (agentic DNA) is an open standard for organizing a project's files so AI agents — and the people working with them — always know where things live. This site is the standard, its docs, and the vault registry."
  jsonLD={jsonLD}
>
  {/* HAUSSMANN P1.1 / ADR-048 — definition-as-hero (candidate A, ratified DP2): the lead defines,
      the audience sub + NOT-line qualify, and the manifesto lyric demotes INTACT to the movement
      band directly below the fold. Claim register rows R-13/R-14 resolved 2026-08-17. */}
  <HomeHero
    heroImage={heroImage}
    heroAlt="A pixel-art hero in the Tokyo Night palette: a glowing cyan DNA double-helix rising from a row of small computers and branching at the top into a network of connected nodes — shared inheritance resolving into the aDNA network."
    audienceSub="For teams working with agentic coding tools on real projects."
    notLine="Not a product or service — no server, no signup, nothing leaves your machine."
    reframe="Your context is just the notes, docs, and decisions you already keep — now shaped into a graph your agents can navigate, and shared in the open."
    primaryHref="/vaults"
    primaryLabel="Explore the network"
    secondaryHref="/get-started"
    secondaryLabel="Get Started"
    proofLead={`${vaultCount} vaults — every one of them on a single computer, ours. ${connectedCount} are joined by ${edgeCount} declared relationships; the rest stand alone.`}
    proofHref="/state-of-the-network/"
    proofLinkLabel="The state of the network, dated →"
    proofHrefSecondary="/about/"
    proofLinkLabelSecondary="Who's behind aDNA →"
    stats={stats}
    heroGraph={heroGraph}
    heroGraphCaption="15 connected vaults · 14 relationships"
    installOneLiner={installTruth.one_liner}
    showLicenseEyebrow={true}
  />

  {/* The movement band — the manifesto lyric, demoted intact from the hero (ADR-048: "demoted
      *intact* to the movement band directly below the fold"). The lyric register survives; the
      fold now belongs to the definition. */}
  <section class="movement-band">
    <p class="movement-lyric">
      Language and DNA were co-created by everyone before us. The context that powers AI should be
      too — built, shared, and governed in the open, for the good of all.
    </p>
    {/* HAUSSMANN P1.2 — the "you already do X" reframe at the manifesto (Berthier's build-wave
        item: the manifesto is "abstract where it should be concrete"). Deliberately a SIBLING
        paragraph: the lyric above is claim-register row R-94 and ships byte-intact per ratified
        ADR-048, so it is never reflowed, merged, or re-punctuated to accommodate this. The hero's
        `reframe` prop carries the fold-level beat; this is its concrete twin below the fold. */}
    <p class="movement-reframe">
      You already do the first half of this. The README that explains the project. The decision
      someone wrote down so nobody re-litigates it. The note on why the schema is shaped the way it
      is. That is context — aDNA gives it a shape your agents can read and a place to be shared.
    </p>
  </section>

  <!-- 1 · What a context democracy is -->
  <section class="context-democracy">
    <div class="section-inner">
      <h2 class="section-title">What a context democracy is</h2>
      <p class="section-subtitle">
        A self-governed network where people and their agents build, share, and govern
        context graphs in the open — each project its own graph, all of them federating
        into a shared commons.
      </p>
      {/* Storyweave P3 / M3.2 — the S7 first-scroll N-pillar payoff: the hero sells the feeling,
          §1 pays it off with the "how" as a crisp 4-pillar (the Mastodon "Why?" model). */}
      <ul class="democracy-pillars" role="list">
        <li><strong>Open</strong><span>MIT-licensed — the spec, the workspace image, and the registry data are public.</span></li>
        <li><strong>Federated</strong><span>Each project keeps its own graph; they connect by citation, not central control.</span></li>
        <li><strong>Co-owned</strong><span>No vendor owns your context — you govern it, in the open.</span></li>
        <li><strong>Agents &amp; humans</strong><span>One graph, legible to your AI and to you at the same time.</span></li>
      </ul>
      <NetworkDiagram />
      <p class="diagram-caption">
        Real aDNA vaults — forges, frameworks, platforms, and public-good archives —
        connected by the relationships they declare.
      </p>
    </div>
  </section>

  <!-- 2 · The living registry -->
  <section class="living-registry">
    <div class="section-inner">
      <h2 class="section-title">The living registry</h2>
      <p class="section-subtitle">
        Every vault is a real, governed context graph with its own place in the network —
        most tended by a named agent. Here's a slice across {vaultCount} of them.
      </p>
      {/* HAUSSMANN P1.2 (§7.3) — the operator-federation distinction is made where the number is
          made, not only in the fold. A reader meeting "{vaultCount}" for the second time meets the
          qualifier with it. */}
      <p class="registry-disclosure">
        All of them run on one computer —
        <a href="/state-of-the-network/" data-astro-prefetch>the state of the network</a> says whose,
        and what that means.
      </p>
      <div class="registry-grid">
        {registryVaults.map((v) => (
          <RegistryCard vault={v} classLabel={classLabel(v.class)} />
        ))}
      </div>
      <p class="registry-actions">
        <a href="/vaults/">See all {vaultCount} vaults &rarr;</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/vaults/graph/">View the relationship graph &rarr;</a>
      </p>
    </div>
  </section>

  <!-- How it Works -->
  <section class="how-it-works">
    <div class="section-inner">
      <h2 class="section-title">How it Works</h2>
      <p class="section-subtitle">Three steps from scattered files to a project your agents can navigate — and keep navigating.</p>
      <div class="feature-strip">
        <div class="feature-item">
          <strong>Agent-native</strong>
          <span>Governance files and typed context give agents orientation — no prompt re-engineering every session.</span>
        </div>
        <div class="feature-item">
          <strong>Human-readable</strong>
          <span>Every file is plain Markdown. Browse in Obsidian, VS Code, or GitHub. No proprietary formats, no lock-in.</span>
        </div>
        <div class="feature-item">
          <strong>Composable</strong>
          <span>Modules, datasets, and lattices compose into workflows. Start small, scale to multi-team campaigns with the same primitives.</span>
        </div>
      </div>
      <div class="steps-grid">
        {steps.map((step) => (
          <div class="step">
            <div class="step-number">{step.number}</div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-description">{step.description}</p>
            <Fragment set:html={step.demo} />
          </div>
        ))}
      </div>
      <!-- N-07 / F-CHM-210 (M4.2 rider): the public image ships no in-repo tutorials — it
           points newcomers here. So the landing page must carry a findable "start here"
           learning on-ramp, not just a "dive deeper" footnote for the already-convinced.
           The prior `.how-footer` line was demoted-in-place below the explicit on-ramp. -->
      <div class="learn-onramp">
        <h3 class="onramp-title">New to aDNA? Start here</h3>
        <p class="onramp-lead">
          Cloned the workspace image and want to understand it before you build? The standard
          embeds in <code>.adna/</code>; the guided path lives here — a five-minute tour, the
          core concepts, and hands-on tutorials.
        </p>
        <div class="onramp-actions">
          <a href="/learn" class="btn btn-primary" data-astro-prefetch>Learn aDNA</a>
          <a href="/learn/what-is-adna" class="btn btn-secondary" data-astro-prefetch>What is aDNA? &rarr;</a>
          <a href="/learn/tutorials" class="btn btn-secondary" data-astro-prefetch>Tutorials &rarr;</a>
        </div>
      </div>
      <p class="how-footer">
        Dive deeper: <a href="/learn/concepts/convergence">Convergence Model</a> · <a href="/learn">Concepts &amp; Tutorials</a> · <a href="/reference">Reference Specification</a>
      </p>
    </div>
  </section>

  <!-- The Standard -->
  <section class="the-standard">
    <div class="section-inner">
      <h2 class="section-title">The Standard</h2>
      <p class="section-subtitle">aDNA is an open specification — MIT licensed, open to contribution, designed for extension.</p>
      <div class="standard-meta">
        <span class="meta-tag">{STANDARD_VERSION}</span>
        <span class="meta-tag">MIT License</span>
        <span class="meta-tag">Open Standard</span>
        <span class="meta-tag">{ENTITY_TYPE_COUNT} Entity Types</span>
      </div>
      <div class="standard-cta">
        <a href="/reference/specification" class="btn btn-primary" data-astro-prefetch>Read the Specification</a>
        <a href="https://github.com/aDNA-Network/aDNA" class="btn btn-secondary" target="_blank" rel="noopener">View on GitHub</a>
      </div>
    </div>
  </section>

  <!-- 5 · Join the network -->
  <section class="join-network">
    <div class="section-inner">
      <h2 class="section-title">Join the network</h2>
      <p class="section-subtitle">
        The network is open — run a node, share a vault, and help
        <a href="/reference/governance-model/">shape the standard</a>.
        Mission-aligned subnetworks are taking shape around real public-good work.
      </p>
      <ul class="subnetwork-tease">
        {subnetworks.map((s) => (
          <li class="tease-item">
            <a href="/commons/#featured" class="tease-name">{s.display_name}</a>
            <span class="tease-tagline">{s.tagline}</span>
          </li>
        ))}
      </ul>
      <div class="join-cta">
        <a href="/commons/" class="btn btn-primary" data-astro-prefetch>See the commons</a>
        <a href="/community/" class="btn btn-secondary" data-astro-prefetch>Join the community</a>
      </div>
      <p class="audience-pathways">
        <span class="pathways-label">aDNA for</span>
        {audiences.map((a, i) => (
          <Fragment>
            <a href={a.href}>{a.label}</a>{i < audiences.length - 1 && <span class="sep" aria-hidden="true">·</span>}
          </Fragment>
        ))}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ——— Movement band (ADR-048): the demoted manifesto lyric, one quiet full-width statement
     directly below the fold. Reads as the "why", after the hero has answered the "what". ——— */
  .movement-band {
    padding: var(--space-10) var(--space-6);
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .movement-lyric {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-text);
    text-wrap: balance;
  }

  /* The concrete twin under the lyric — quieter and smaller, so the lyric keeps the band and this
     grounds it rather than competing with it. */
  .movement-reframe {
    max-width: 42rem;
    margin: var(--space-5) auto 0;
    text-align: center;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* ——— Shared section styles ——— */
  .section-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .section-title {
    font-size: var(--text-3xl);
    text-align: center;
    margin-bottom: var(--space-3);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    max-width: 36rem;
    margin: 0 auto var(--space-10);
    line-height: 1.6;
  }

  /* The disclosure line under the registry count — sits between the subtitle and the grid, quieter
     than the subtitle it qualifies. It pulls up under the subtitle's bottom margin so the pair
     reads as one block. */
  .registry-disclosure {
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    max-width: 36rem;
    margin: calc(var(--space-10) * -1 + var(--space-3)) auto var(--space-10);
    line-height: 1.6;
  }

  /* ——— 1 · What a context democracy is ——— */
  .context-democracy {
    padding: var(--space-24) 0;
  }

  /* Storyweave P3 / M3.2 — the S7 first-scroll 4-pillar payoff. Tokens only (AA both modes). */
  .democracy-pillars {
    list-style: none;
    padding: 0;
    margin: var(--space-8) auto 0;
    max-width: 60rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }
  .democracy-pillars li {
    text-align: left;
    padding: var(--space-4);
    border-top: 2px solid var(--color-primary);
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
  }
  .democracy-pillars strong {
    display: block;
    font-family: var(--font-display);
    color: var(--color-text-heading);
    margin-bottom: var(--space-1);
  }
  .democracy-pillars span {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  @media (max-width: 780px) {
    .democracy-pillars { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 420px) {
    .democracy-pillars { grid-template-columns: 1fr; }
  }

  .diagram-caption {
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    max-width: 34rem;
    margin: var(--space-8) auto 0;
    line-height: 1.6;
  }

  /* ——— 2 · The living registry ——— */
  .living-registry {
    padding: var(--space-24) 0;
  }

  .registry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-5);
  }

  .registry-actions {
    text-align: center;
    margin-top: var(--space-10);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-sm);
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .registry-actions a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .registry-actions a:hover {
    text-decoration: underline;
  }

  .registry-actions .sep {
    color: var(--color-border);
  }

  /* ——— How it Works ——— */
  .how-it-works {
    padding: var(--space-24) 0;
    background: var(--color-bg-alt);
    overflow-x: hidden;
  }

  .feature-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-12);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-primary);
  }

  .feature-item strong {
    font-size: var(--text-base);
    color: var(--color-text-heading);
  }

  .feature-item span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-8);
  }

  .step {
    text-align: center;
    padding: var(--space-8) var(--space-6);
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    min-width: 0;
  }

  .step-number {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    /* Cyan accent — AA both modes (purple --color-primary fails for sm text). */
    color: var(--color-link);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .step-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .step-description {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .step-demo {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #13131f;
    width: 100%;
    box-sizing: border-box;
  }

  .step-demo-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: #1c1c2e;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .demo-dots {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .demo-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .demo-dots span:nth-child(1) { background: #ff5f57; }
  .demo-dots span:nth-child(2) { background: #febc2e; }
  .demo-dots span:nth-child(3) { background: #28c840; }

  .demo-filename {
    color: #aaa;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.01em;
  }

  .step-demo-pre {
    margin: 0;
    padding: var(--space-4);
    color: #c9c9df;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.65;
    white-space: pre;
    overflow-x: auto;
    max-width: 100%;
    box-sizing: border-box;
  }

  .how-footer {
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-10);
    line-height: 1.6;
  }

  .how-footer a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .how-footer a:hover {
    text-decoration: underline;
  }

  /* ——— Learning on-ramp (N-07 / F-CHM-210): a findable "start here" for the
     image-holding newcomer — the site is the learning home the image points at. ——— */
  .learn-onramp {
    max-width: 44rem;
    margin: var(--space-12) auto 0;
    padding: var(--space-8) var(--space-6);
    text-align: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .onramp-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .onramp-lead {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.6;
    max-width: 36rem;
    margin: 0 auto var(--space-6);
  }

  .onramp-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ——— The Standard ——— */
  .the-standard {
    /* §5 (.join-network) closes the page now — the --space-32 tail moved there (c165). */
    padding: var(--space-24) 0;
    background: var(--color-bg-alt);
  }

  .standard-meta {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .meta-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.25em 0.75em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--color-surface);
    letter-spacing: 0.03em;
  }

  .standard-cta {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ——— 5 · Join the network ——— */
  .join-network {
    padding: var(--space-24) 0 var(--space-32);
  }

  /* In-text link inside the subtitle — underlined (link-in-text-block, c155 lesson). */
  .join-network .section-subtitle a {
    color: var(--color-link);
    text-decoration: underline;
  }

  .subnetwork-tease {
    list-style: none;
    margin: 0 auto var(--space-10);
    padding: 0;
