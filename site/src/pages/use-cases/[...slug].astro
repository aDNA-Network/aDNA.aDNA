---
import { getCollection, render } from 'astro:content';
import DocumentationLayout from '../../layouts/DocumentationLayout.astro';
import { buildTechArticleJsonLD, buildBreadcrumbListJsonLD } from '../../utils/seo';

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ data }) => data.section === 'use-cases' && !data.draft);
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://adna.dev';

const jsonLD = [
  buildTechArticleJsonLD({
    title: doc.data.doc_title,
    description: doc.data.description ?? '',
    url: Astro.url.href,
  }),
  buildBreadcrumbListJsonLD([
    { name: 'Home', url: `${siteBase}/` },
    { name: 'Use Cases', url: `${siteBase}/use-cases/` },
    { name: doc.data.doc_title },
  ]),
];
---

<DocumentationLayout
  title={doc.data.doc_title}
  description={doc.data.description ?? `${doc.data.doc_title} — aDNA use case.`}
  headings={headings}
  jsonLD={jsonLD}
>
  {/* HAUSSMANN P1.1 (hostile-read finding 13): the hub carries the "illustrative scenarios"
      disclosure but deep links land here without it — every leaf now discloses on-page, so a
      reader arriving from /compliance or /enterprise (or a search snippet) never mistakes the
      named personas for real adopters. Mirrors the /adopters anti-claim (claim register R-76). */}
  <p class="uc-illustrative-note">
    ℹ Illustrative scenario — a composite archetype, not a real named adopter.
  </p>
  <Content />
</DocumentationLayout>

<style>
  .uc-illustrative-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    border-left: 3px solid var(--color-border);
    padding-left: var(--space-3);
    margin: 0 0 var(--space-6);
  }
</style>
