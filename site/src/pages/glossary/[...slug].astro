---
import { getCollection, render } from 'astro:content';
import DocumentationLayout from '../../layouts/DocumentationLayout.astro';
import { sourceForEntry } from '../../utils/contentSource';
import { buildTechArticleJsonLD, buildBreadcrumbListJsonLD } from '../../utils/seo';
import { SITE_ORIGIN } from '../../data/canonical';

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ data }) => data.section === 'glossary' && !data.draft);
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const source = sourceForEntry(doc);
const { Content, headings } = await render(doc);

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? SITE_ORIGIN;

const jsonLD = [
  buildTechArticleJsonLD({
    title: doc.data.doc_title,
    description: doc.data.description ?? '',
    url: Astro.url.href,
  }),
  buildBreadcrumbListJsonLD([
    { name: 'Home', url: `${siteBase}/` },
    { name: 'Glossary', url: `${siteBase}/glossary/` },
    { name: doc.data.doc_title },
  ]),
];
---

<DocumentationLayout
  title={doc.data.doc_title}
  description={doc.data.description ?? `${doc.data.doc_title} — aDNA glossary entry.`}
  headings={headings}
  jsonLD={jsonLD}

  source={source}
>
  <Content />
</DocumentationLayout>
