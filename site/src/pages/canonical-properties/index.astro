---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PUBLISHER } from '../../data/canonical';
import { CANONICAL_PROPERTIES, PROPERTIES_PROBED_AT } from '../../data/canonical_properties';
import { buildWebPageJsonLD } from '../../utils/seo';

// HAUSSMANN P1.2 — the §7.1 clone-site defense, rendered.
//
// Both comparable projects in this category have spawned large numbers of SEO clone sites: parallel
// domains reproducing project descriptions with fabricated testimonials, invented attribution, and
// inflated metrics, several of them outranking or sitting adjacent to the official properties in
// search. The instrument's counter-measures are: assert the canonical domain in structured data,
// publish an official-properties page, link it from the footer — and never run the clone pattern
// yourself.
//
// Every row here comes from canonical_properties.ts, the same list that feeds Organization.sameAs,
// so the page a human reads and the graph a machine reads cannot drift apart. Adding a property
// means probing it logged-out first and recording the date — never the reverse.
const domains = CANONICAL_PROPERTIES.filter((p) => p.kind === 'domain' && p.resolves);
const orgs = CANONICAL_PROPERTIES.filter((p) => p.kind === 'org' && p.resolves);
const repos = CANONICAL_PROPERTIES.filter((p) => p.kind === 'repo' && p.resolves);
const machineSurfaces = CANONICAL_PROPERTIES.filter((p) => p.kind === 'machine-surface' && p.resolves);
const retired = CANONICAL_PROPERTIES.filter((p) => p.kind === 'retired');

const jsonLD = buildWebPageJsonLD({
  title: 'Canonical properties — aDNA',
  description:
    'Every legitimate aDNA domain, repository, organization, and machine surface — each checked from outside, with the date. If you found aDNA somewhere that is not on this list, it is not us.',
  url: new URL('/canonical-properties/', Astro.site ?? 'https://adna.network').href,
});
---

<BaseLayout
  title="Canonical properties — aDNA"
  description="Every legitimate aDNA domain, repository, organization, and machine surface — each checked from outside, with the date. If you found aDNA somewhere that is not on this list, it is not us."
  jsonLD={jsonLD}
>
  <article class="policy">
    <header class="policy-head">
      <h1>Canonical properties</h1>
      <p class="policy-lead">
        So you can tell a real aDNA property from a copy of one.
        <strong>Every public property aDNA operates or vouches for is on this list.</strong> If you
        found something calling itself aDNA that is not here and is not linked from a page on this
        site, treat it as not us. Every domain, organization, and repository below was opened from
        outside, logged out, on the date shown.
      </p>
    </header>

    <h2 id="domains">Domains</h2>
    <ul class="prop-ledger" role="list">
      {domains.map((p) => (
        <li class="prop-row">
          <h3 class="prop-name">
            <a href={p.url} target="_blank" rel="noopener">{p.label}</a>
            {p.ownerNote && <span class="prop-tag">who runs it</span>}
          </h3>
          <dl class="prop-facts">
            <div class="prop-fact"><dt>What it is</dt><dd>{p.what}</dd></div>
            {p.ownerNote && <div class="prop-fact"><dt>Who runs it</dt><dd>{p.ownerNote}</dd></div>}
            <div class="prop-fact"><dt>Checked</dt><dd>{p.probed}{p.evidence ? ` — ${p.evidence}` : ''}</dd></div>
          </dl>
        </li>
      ))}
    </ul>

    <h2 id="organizations">Organizations</h2>
    <ul class="prop-ledger" role="list">
      {orgs.map((p) => (
        <li class="prop-row">
          <h3 class="prop-name">
            <a href={p.url} target="_blank" rel="noopener">{p.label}</a>
          </h3>
          <dl class="prop-facts">
            <div class="prop-fact"><dt>What it is</dt><dd>{p.what}</dd></div>
            {p.ownerNote && <div class="prop-fact"><dt>Who runs it</dt><dd>{p.ownerNote}</dd></div>}
            <div class="prop-fact"><dt>Checked</dt><dd>{p.probed}{p.evidence ? ` — ${p.evidence}` : ''}</dd></div>
          </dl>
        </li>
      ))}
    </ul>

    <h2 id="repositories">Repositories</h2>
    <ul class="prop-ledger" role="list">
      {repos.map((p) => (
        <li class="prop-row">
          <h3 class="prop-name">
            <a href={p.url} target="_blank" rel="noopener">{p.label}</a>
            {p.ownerNote && <span class="prop-tag">who runs it</span>}
          </h3>
          <dl class="prop-facts">
            <div class="prop-fact"><dt>What it is</dt><dd>{p.what}</dd></div>
            {p.ownerNote && <div class="prop-fact"><dt>Who runs it</dt><dd>{p.ownerNote}</dd></div>}
            <div class="prop-fact"><dt>Checked</dt><dd>{p.probed}{p.evidence ? ` — ${p.evidence}` : ''}</dd></div>
          </dl>
        </li>
      ))}
    </ul>
    <p>
      Not every repository under our organization is listed. One vault in the registry records a
      repository URL that does not resolve publicly, so it is not something you can check &mdash; it
      is counted, without a link, on
      <a href="/state-of-the-network/" data-astro-prefetch>the state of the network</a>. A list of
      things you can trust should only contain things you can reach.
    </p>

    <h2 id="machine-surfaces">Machine surfaces</h2>
    <p>
      The files this site publishes for agents and readers that are not browsers. These are this
      site's own paths rather than separate properties, so there is no outside to check them from
      &mdash; open them yourself.
    </p>
    <ul class="prop-ledger" role="list">
      {machineSurfaces.map((p) => (
        <li class="prop-row">
          <h3 class="prop-name"><a href={p.url}>{p.label}</a></h3>
          <dl class="prop-facts">
            <div class="prop-fact"><dt>What it is</dt><dd>{p.what}</dd></div>
          </dl>
        </li>
      ))}
    </ul>

    <h2 id="social">Social accounts</h2>
    <p>
      <strong>aDNA runs no social accounts.</strong> Any account using the name is not us.
    </p>
    <p>
      If that changes, it will be listed here first, and this sentence will be the thing that
      changed.
    </p>

    <h2 id="retired">Retired, and not us</h2>
    <ul class="prop-ledger" role="list">
      {retired.map((p) => (
        <li class="prop-row prop-row--retired">
          <h3 class="prop-name">{p.label} <span class="prop-tag">retired</span></h3>
          <dl class="prop-facts">
            <div class="prop-fact"><dt>What it was</dt><dd>{p.what}</dd></div>
            <div class="prop-fact"><dt>Checked</dt><dd>{p.probed}{p.evidence ? ` — ${p.evidence}` : ''}</dd></div>
          </dl>
        </li>
      ))}
    </ul>
    <p>
      A lapsed domain is named here rather than quietly dropped. Silence would leave it free to be
      re-registered against us, with no way for you to tell.
    </p>

    <h2 id="verify">How to verify you are on a real property</h2>
    <p>One check settles it. The others only corroborate, and we would rather say so than pad the
      list.</p>
    <ul class="prop-bullets">
      <li>
        <strong>Look at your address bar.</strong> If it does not read <code>adna.network</code>, you
        are not on our site. A copy can reproduce every word on this page &mdash; that is what
        copying is &mdash; but it cannot serve them from our domain. This is the only check that a
        clone cannot pass.
      </li>
      <li>
        Corroboration: every page in this site's navigation links back to this one from its footer,
        and the site name in the page's metadata and copyright line reads <strong>{PUBLISHER}</strong>.
      </li>
      <li>
        Corroboration: the structured data on every page names this organization, with its home at
        this domain and its other presences listed. Note that a copy can reproduce that too, so read
        it as a signal, not as proof.
      </li>
    </ul>

    <h2 id="never">What we will never do</h2>
    <p>
      We publish no testimonials &mdash; attributed or otherwise. We will never contact you asking
      for a key, a token, or a payment. Invented quotes and invented attribution are the clone-site
      signature; if you see them beside this project's name, you are not on our site.
    </p>

    {/* HAUSSMANN P1.2 close · re-rank finding F2 (register R-113, S2). This page dead-ended at the
        footer while its twin — built in the same mission, sharing this scaffold — closes with real
        exits. Both reviewer lenses found the asymmetry independently. Same pattern as
        /state-of-the-network/#where-next, not a new one: a reader who has just satisfied themselves
        the site is genuine is at the point of highest intent, and the page was spending it on a
        full stop. */}
    <h2 id="where-next">Where to go from here</h2>
    <p>
      <strong>If you came here to check this site is the real one:</strong> it is, and the address
      bar is the proof. <a href="/state-of-the-network/" data-astro-prefetch>What actually runs, and
      who operates it &rarr;</a>
    </p>
    <p>
      <strong>If you found something claiming to be aDNA that is not on this list:</strong> we want
      to know. <a href="/security/" data-astro-prefetch>How to report it &rarr;</a>
    </p>
    <p>
      <a href="/get-started/" data-astro-prefetch>Clone the standard &rarr;</a> &middot;
      <a href="/vaults/" data-astro-prefetch>Browse the registry &rarr;</a> &middot;
      <a href="/about/" data-astro-prefetch>Who&rsquo;s behind aDNA &rarr;</a>
    </p>

    <p class="policy-foot">
      Every domain, organization, and repository above last checked from outside, logged out, on
      {PROPERTIES_PROBED_AT}. See also
      <a href="/state-of-the-network/" data-astro-prefetch>the state of the network</a> for what
      actually runs and who operates it.
    </p>
  </article>
</BaseLayout>

<style>
  /* Same policy scaffold as /privacy, /security, /state-of-the-network. Tokens only (gate-25). */
  .policy {
    max-width: 46rem;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-24);
  }
  .policy-head {
    margin-bottom: var(--space-10);
  }
  .policy h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }
  .policy-lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.6;
  }
  .policy h2 {
    font-size: var(--text-xl);
    margin: var(--space-10) 0 var(--space-3);
  }
  .policy p {
    line-height: 1.7;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }
  .policy a {
    color: var(--color-link);
    text-decoration: underline;
  }

  .prop-bullets {
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 var(--space-4);
    padding-left: var(--space-6);
  }
  .prop-bullets li {
    margin-bottom: var(--space-3);
  }

  /* Label/value grid rather than a <table>: a two-column table of long URLs is the 320px overflow
     class that gate-9 and gate-29 exist to catch. This stacks instead. */
  .prop-ledger {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .prop-row {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .prop-row--retired {
    border-style: dashed;
    background: none;
  }
  .prop-name {
    font-size: var(--text-base);
    font-family: var(--font-mono);
    margin: 0 0 var(--space-2);
    overflow-wrap: anywhere;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }
  /* Ownership/lifecycle carried in WORDS, never by colour alone (gate-18). */
  .prop-tag {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-2);
  }
  .prop-facts {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-1) var(--space-6);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .prop-fact {
    display: contents;
  }
  .prop-fact dt {
    color: var(--color-text-muted);
  }
  .prop-fact dd {
    margin: 0;
    color: var(--color-text);
  }

  .policy-foot {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 760px) {
    .prop-facts {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .prop-fact dt {
      margin-top: var(--space-2);
    }
  }
</style>
