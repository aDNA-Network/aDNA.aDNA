---
import { ClientRouter } from 'astro:transitions';
import SEOHead from '../components/common/SEOHead.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import interLatinFont from '@fontsource/inter/files/inter-latin-400-normal.woff2';
import spaceGroteskLatinFont from '@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2';
import spaceGroteskLatin700Font from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2';

type JsonLDValue = Record<string, unknown> | Record<string, unknown>[];

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  jsonLD?: JsonLDValue;
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  canonicalURL,
  jsonLD,
  bodyClass = '',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Subscribable feed (idea_site_rss_feed / Champollion M4.2) — a cheap
         "actively maintained" signal + the standard watch-mechanism for evaluators. -->
    <link rel="alternate" type="application/rss+xml" title="aDNA — Changelog" href="/rss.xml" />

    <!-- Preload critical above-fold fonts (latin subsets only) -->
    <link rel="preload" href={interLatinFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={spaceGroteskLatinFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={spaceGroteskLatin700Font} as="font" type="font/woff2" crossorigin />

    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
      jsonLD={jsonLD}
      noindex={noindex}
    />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>

    <script is:inline>
      (function () {
        const applyTheme = () => {
          // Dark-first (ADR-032): the Tokyo Night register is the default for every
          // visitor; light is opt-in via the toggle. Dark unless the user chose light.
          const theme = localStorage.getItem('theme');
          const dark = theme !== 'light';
          document.documentElement.classList.toggle('dark', dark);
        };
        applyTheme();
        document.addEventListener('astro:page-load', applyTheme);
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', applyTheme);
      })();
    </script>

    <!-- Field CWV instrument (P4.4b B1): bundled same-origin module, zero-network.
         Gate-50 asserts it is shipped AND emitting; see src/scripts/vitals.ts.
         ⛔ UNTOUCHED by the 2026-09-07 transport increment, deliberately. This is a SECOND,
         in-page measurement that has never left the browser and still does not; the transport
         below is additive beside it, not a replacement for it. /privacy distinguishes the two. -->
    <script>
      import '../scripts/vitals';
    </script>

    <!-- Field CWV TRANSPORT (2026-09-07): Vercel Speed Insights. Renders a
         <vercel-speed-insights> custom element whose script injects
         /_vercel/speed-insights/script.js — a FIRST-PARTY path served by the Vercel platform,
         not emitted into dist/. Measured, not assumed: `grep -rho "/_vercel/[a-z0-9/_.-]*"
         node_modules/@vercel/speed-insights/dist/` -> that exact path [D] 2026-09-07.
         ⇒ under `astro preview` there is no platform, so the request 404s and gate-42 sees a
         same-origin failure. gate-42 carries a SINGLE enumerated exclusion for that one path;
         it is asserted, never assumed, and every other same-origin failure still reds.
         gate-56 asserts this is MOUNTED, not merely installed — a dependency in package.json
         is not a transport (V4's "shipped is not wired"). /privacy shipped FIRST, in the same
         commit, because that page promised in its own voice to change before this did. -->
    <SpeedInsights />

    <ClientRouter />
  </head>
  <body class:list={['min-h-screen flex flex-col', bodyClass]}>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header />

    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
