---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SidebarNav from '../components/sections/SidebarNav.astro';
import TOCPanel from '../components/sections/TOCPanel.astro';
import PrevNextNav from '../components/sections/PrevNextNav.astro';
import Breadcrumb from '../components/sections/Breadcrumb.astro';

type JsonLDValue = Record<string, unknown> | Record<string, unknown>[];

interface Props {
  title: string;
  description: string;
  headings?: { depth: number; slug: string; text: string }[];
  prev?: { label: string; href: string };
  next?: { label: string; href: string };
  jsonLD?: JsonLDValue;
  /**
   * The `hero_panel` slot (ADR-053's normative five-slot table).
   *
   * `credit` added at HAUSSMANN P4.1 O2 — ADR-053's credit law is normative and was UNMET: "every
   * illustrated artifact carries its provenance where a reader can reach it: generator/model lineage
   * and the ruling that commissioned it." The ADR names the mechanism as an additive `credit` field
   * alongside `{ src, alt }` on this prop — never a new component — and byte-identical for any page
   * that does not pass it (skill_documentation_layout_props_additive_extension). Adding the field
   * here is what makes that mechanism exist where the ADR said it would.
   *
   * ⚠ THE FIELD IS ADDED HERE; IT DOES NOT COVER THE `empty_state` SLOT, AND THE DISTINCTION IS
   * WORTH KEEPING. P4.1's AC5(b) required the empty-state credit to ride *this* prop — but /vaults
   * uses BaseLayout + HomeHero, not this layout, and an empty-state mark is not a hero under any
   * layout, so `heroImage` structurally cannot carry it. ADR-053's normative text names the PATTERN
   * (an additive optional prop, byte-identical when absent); AC5 named one INSTANCE of it. The
   * pattern is applied at the slot's own host (EmptyStateMark.astro); the named instance is here.
   * ⛩ Operator-ruled 2026-08-24 — both, not either. Record: slot_spec_empty_state.md §6.1.
   *
   * A credit must not imply a generation pipeline exists: ADR-053 names ours as OWED, not built.
   */
  heroImage?: { src: ImageMetadata; alt: string; credit?: string };
  /**
   * Page provenance — last-updated date and an edit link (HAUSSMANN P2.3 O2, VITRUVIUS D4).
   *
   * Purely additive and optional: a consumer that does not pass it renders byte-identically to
   * before (skill_documentation_layout_props_additive_extension). Build it with
   * `sourceForEntry()` / `sourceForSpec()` in utils/contentSource.ts — `updated` is deliberately
   * absent rather than guessed when git cannot answer.
   */
  source?: { editUrl: string; updated?: string; editLabel?: string };
}

const { title, description, headings = [], prev, next, jsonLD, heroImage, source } = Astro.props;
---

<BaseLayout title={title} description={description} jsonLD={jsonLD}>
  <div class="doc-layout">
    <!-- Mobile section nav (audit C3: the sidebar was display:none below 768px, leaving
         doc pages with no section navigation on phones). Native disclosure, zero JS; the
         desktop <aside> below is display:none'd on mobile so only one copy is ever in
         the accessibility tree. -->
    <details class="doc-mobile-nav">
      <summary>In this section</summary>
      <div class="doc-mobile-nav-inner">
        <SidebarNav label="Section navigation" />
      </div>
    </details>

    <!-- SP-2 (H-1/H-2): the <article> (with its <h1>) comes BEFORE the <aside> sidebars in
         DOM so a screen reader / agent reads breadcrumb → h1 → content before the ~100 nav
         links. The visual column order (sidebar | content | toc) is restored via
         grid-template-areas below, so there is no visual change. The skip-link (#main-content)
         now lands on the content, not the sidebar. -->
    <article class="doc-content prose">
      <Breadcrumb pageTitle={title} />
      {heroImage && (
        <Image
          src={heroImage.src}
          alt={heroImage.alt}
          class="doc-hero"
          widths={[640, 960, 1280, 1408]}
          sizes="(min-width: 1280px) 880px, (min-width: 768px) calc(100vw - 14rem), 100vw"
          loading="eager"
        />
      )}
      {/* Additive and optional: a page passing `{ src, alt }` without `credit` emits nothing here
          and renders byte-identically to before this field existed. gate-35 asserts that rather
          than assuming it. */}
      {heroImage?.credit && <p class="doc-hero-credit">{heroImage.credit}</p>}
      <h1>{title}</h1>
      <slot />
      {source && (
        <footer class="doc-provenance">
          {source.updated && (
            <span class="doc-provenance-updated">
              Last updated <time datetime={source.updated}>{source.updated}</time>
            </span>
          )}
          <a class="doc-provenance-edit" href={source.editUrl} rel="noopener">
            {source.editLabel ?? 'Edit this page'}
          </a>
        </footer>
      )}
      {(prev || next) && <PrevNextNav prev={prev} next={next} />}
    </article>

    <aside class="doc-sidebar" aria-label="Documentation navigation">
      <SidebarNav />
    </aside>

    <aside class="doc-toc" aria-label="Table of contents">
      {headings.length > 0 && <TOCPanel headings={headings} />}
    </aside>
  </div>
</BaseLayout>

<script>
  // Wrap bare <pre> elements in .doc-content with a copy button.
  // Skips pre elements already inside .code-block (those are handled by CodeBlock.astro).
  function initCopyButtons() {
    const pres = document.querySelectorAll<HTMLPreElement>('.doc-content pre:not(.code-block pre)');
    pres.forEach((pre) => {
      if (pre.closest('.code-block')) return; // already wrapped

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';

      const inner = document.createElement('div');
      inner.className = 'code-content';

      pre.parentNode!.insertBefore(wrapper, pre);
      wrapper.appendChild(inner);
      inner.appendChild(pre);

      // Scrollable code samples must be keyboard-reachable (axe scrollable-region-focusable —
      // audit P1-S3, /learn/what-is-adna).
      if (!pre.hasAttribute('tabindex')) pre.setAttribute('tabindex', '0');

      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.type = 'button';
      btn.setAttribute('aria-label', 'Copy code');
      btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>`;
      wrapper.appendChild(btn);

      btn.addEventListener('click', async () => {
        const text = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
        await navigator.clipboard.writeText(text);
        btn.setAttribute('aria-label', 'Copied!');
        setTimeout(() => btn.setAttribute('aria-label', 'Copy code'), 2000);
      });
    });
  }

  // Run on initial load and after each client-side navigation
  initCopyButtons();
  document.addEventListener('astro:page-load', initCopyButtons);
</script>

<style>
  /* F1 (HAUSSMANN P1.4): the base grid MUST define its named areas. Without them,
     `grid-area: content` resolves to implicit named lines and throws the article into an
     implicit second column beside the explicit track — on phones the page rendered a dead
     left gutter with body text squeezed to ~185px (computed columns "141px 0px 233px" at
     375). Invisible to gate-9 (nothing overflows; the article just shrinks). */
  .doc-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "mobilenav"
      "content";
    max-width: var(--content-width);
    margin: 0 auto;
    min-height: calc(100vh - 8rem);
  }

  .doc-sidebar {
    display: none;
    grid-area: sidebar;
    position: sticky;
    top: 3.5rem;
    height: calc(100vh - 3.5rem);
    overflow-y: auto;
    padding: var(--space-6) var(--space-4);
    border-right: 1px solid var(--color-border);
  }

  /* ——— Mobile section-nav disclosure (<768px only) ——— */
  .doc-mobile-nav {
    grid-area: mobilenav;
    margin: var(--space-4) var(--space-6) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    /* Page ground, NOT --color-surface: the switcher's purple .active link is AA on the
       page bg (matching the desktop sidebar) but only 3.9:1 on the elevated card surface
       (the E5 c160 purple-on-surface class — axe-caught here at the c165 probe). */
  }

  .doc-mobile-nav > summary {
    list-style: none;
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .doc-mobile-nav > summary::-webkit-details-marker {
    display: none;
  }

  .doc-mobile-nav > summary::before {
    content: '▸ ';
    display: inline-block;
    transition: transform var(--transition-fast);
    font-size: 0.7em;
    margin-right: var(--space-2);
  }

  .doc-mobile-nav[open] > summary::before {
    transform: rotate(90deg);
  }

  .doc-mobile-nav-inner {
    padding: var(--space-2) var(--space-4) var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .doc-content {
    grid-area: content;
    padding: var(--space-8) var(--space-6);
    min-width: 0;
    overflow-x: hidden;
  }

  /* Page provenance (HAUSSMANN P2.3 O2). Sits between the content and PrevNextNav; wraps rather
     than truncates so the date and the edit link both survive a 320px viewport (WCAG 1.4.10). */
  .doc-provenance {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .doc-provenance-edit {
    color: var(--color-link);
    font-weight: 500;
  }

  /* F12 (HAUSSMANN P1.4): the copy-button wrapper below is built at RUNTIME by this layout's
     script, so CodeBlock.astro's scoped styles never reach it — the button rendered as a plain
     inline element on its own line under every block. Mirror the CodeBlock idiom here via
     :global (same tokens, same 44px mobile affordance). */
  .doc-content :global(.code-block) {
    position: relative;
    margin: 0 0 var(--space-6);
  }
  .doc-content :global(.code-block pre) {
    margin: 0;
  }
  .doc-content :global(.copy-btn) {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-1);
    color: var(--color-text-muted);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--transition-fast), color var(--transition-fast);
  }
  .doc-content :global(.code-block:hover .copy-btn),
  .doc-content :global(.copy-btn:focus-visible) {
    opacity: 1;
  }
  .doc-content :global(.copy-btn:hover) {
    color: var(--color-text);
  }
  @media (max-width: 640px) {
    .doc-content :global(.copy-btn) {
      opacity: 1;
      min-height: 44px;
      min-width: 44px;
      padding: var(--space-2);
    }
  }

  .doc-content :global(.doc-hero) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
    background: var(--color-bg-alt);
  }

  /* `hero_panel` credit (ADR-053, added P4.1 O2). Pulled up under the hero it describes — the hero's
     own bottom margin would otherwise leave the credit floating between two unrelated blocks.
     Token colour only; --color-text-muted is an already-AA-verified pair in both themes. */
  .doc-content :global(.doc-hero-credit) {
    margin: calc(var(--space-6) * -1 + var(--space-3)) 0 var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-sm, 0.9rem);
  }

  .doc-toc {
    display: none;
    grid-area: toc;
    position: sticky;
    top: 3.5rem;
    height: calc(100vh - 3.5rem);
    overflow-y: auto;
    padding: var(--space-6) var(--space-4);
  }

  /* Tablet: show sidebar, hide the mobile disclosure */
  @media (min-width: 768px) {
    .doc-layout {
      grid-template-columns: var(--sidebar-width) 1fr;
      grid-template-areas: "sidebar content";
    }

    .doc-sidebar {
      display: block;
    }

    .doc-mobile-nav {
      display: none;
    }
  }

  /* Desktop: show TOC */
  @media (min-width: 1280px) {
    .doc-layout {
      grid-template-columns: var(--sidebar-width) 1fr var(--toc-width);
      grid-template-areas: "sidebar content toc";
    }

    .doc-toc {
      display: block;
    }
  }
</style>
